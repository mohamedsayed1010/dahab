# SPA history fallback for React Router (Hostinger / LiteSpeed / Apache).
# Requests for real files and directories are served as-is; everything else
# is handed to index.html so client-side routing can resolve deep links and
# browser refreshes (e.g. /silver/prices, /login) instead of returning a 404.
#
# Notes:
# - No HTTP->HTTPS redirect here on purpose: the host already performs that
#   correctly, and adding a second redirect could cause a redirect loop.
# - No /api rules: the API lives on a separate domain (api.dahbelarby.com),
#   so this frontend host never serves API paths.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly (assets, sitemap.xml,
  # robots.txt, manifest.webmanifest, sw.js, icons, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-lived caching for content-hashed build assets only. Files under
# /assets/ carry a content hash in their name (e.g. index-ABC123.js), so a new
# build produces a new filename — they can be cached for a year immutably.
# index.html, sw.js, the manifest and root images are deliberately excluded so
# they keep revalidating and updates ship immediately.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/assets/" LONG_CACHE
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE
</IfModule>

# Security response headers for the static frontend. The API host
# (api.dahbelarby.com) sets its own equivalent headers; these cover the pages
# and assets served from this domain.
#
# `always` is used so the headers are attached to error responses (404, 500)
# as well as successful ones.
#
# HSTS note: mod_headers' `expr=` conditional is ignored by LiteSpeed, which
# serves this host, so the HTTPS test uses SetEnvIf/env= instead — the same
# mechanism the caching rule above already relies on here. The guard only
# suppresses HSTS when a request is *detectably* plaintext; the host already
# 301s http:// to https:// before this file serves any content, and RFC 6797
# requires browsers to ignore an HSTS header received over http:// anyway.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  SetEnvIf X-Forwarded-Proto "^http$" PLAINTEXT_REQUEST
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" env=!PLAINTEXT_REQUEST

  # This host serves static files only, so nothing sets X-Powered-By today.
  # Unsetting it keeps that true if PHP is ever enabled on the domain.
  Header always unset X-Powered-By
</IfModule>
